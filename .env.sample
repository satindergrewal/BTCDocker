# Data paths — relative to this directory, so the whole drive is portable
BTC_DATA_DIR=./data/btc
FULCRUM_DATA_DIR=./data/fulcrum

# Mempool explorer — paste the same RPC password you used in fulcrum.conf
MEMPOOL_RPC_PASSWORD=<PASTE_RPC_PASSWORD_HERE>

# Bind address for Fulcrum and Mempool ports
# 127.0.0.1 = localhost only (default, most secure)
# 0.0.0.0   = accessible from LAN (any device on your network)
BIND_ADDR=127.0.0.1
